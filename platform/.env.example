# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# Solo servidor. Salta RLS: jamás exponerla al navegador ni commitearla.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ─── Stripe (plataforma Candela) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# OAuth de Stripe Connect: así el cliente conecta SU cuenta sin darnos llaves.
STRIPE_CONNECT_CLIENT_ID=ca_...

# ─── Plataforma ──────────────────────────────────────────────────────────────
# Dominio raíz para subdominios de tenant: <slug>.midominio.com
NEXT_PUBLIC_ROOT_DOMAIN=wearecandela.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Tienda que se sirve en localhost durante el desarrollo.
DEV_STORE_SLUG=candela

# ─── Notificaciones ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
ALERTS_FROM_EMAIL="Candela <alertas@wearecandela.com>"
# Protege el cron de alertas de stock bajo.
CRON_SECRET=genera-un-string-largo-aleatorio
