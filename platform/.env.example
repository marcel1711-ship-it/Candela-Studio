NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxjZ21ma3h4a2JydWxndnZlbmRyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQzMzYyNDcsImV4cCI6MjEwOTkxMjI0N30.NtkjI2xPu_jlfTVvFHThFjSuRDlQlhjZAlAFJlyc7JY

# ⚠️ LLAVE MAESTRA. Salta todas las reglas de seguridad de la base.
#    Cópiala de Supabase → Settings → API → service_role.
#    Va SOLO en Vercel. Nunca en el repo, nunca por chat, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=pegala-aqui-solo-en-vercel

# ─── Plataforma ──────────────────────────────────────────────────────────────
# Tienda que se sirve en localhost y en los dominios *.vercel.app
DEV_STORE_SLUG=candela
# Dominio raíz para los subdominios de cada cliente: <slug>.wearecandela.com
NEXT_PUBLIC_ROOT_DOMAIN=wearecandela.com
# Cámbialo por tu URL real de Vercel cuando la tengas
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Stripe (se puede dejar vacío al principio) ──────────────────────────────
# Sin esto la tienda se ve y el panel funciona; solo el botón de pagar queda
# inactivo. Para cobrar hacen falta las tres primeras.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Para que cada cliente conecte SU propia cuenta de Stripe (Connect)
STRIPE_CONNECT_CLIENT_ID=

# ─── Alertas de stock bajo (opcional al principio) ───────────────────────────
RESEND_API_KEY=
ALERTS_FROM_EMAIL="Candela Hub <alertas@wearecandela.com>"
# Protege el cron diario. Pon cualquier texto largo al azar.
CRON_SECRET=cambia-esto-por-algo-largo-y-aleatorio
